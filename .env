# Environment Configuration Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Default to local SQLite database:
DATABASE_URL=sqlite:///./fraud_detection.db
# Local API uses SQLite by default. Docker Compose supplies PostgreSQL.
# For a local PostgreSQL instance, install psycopg2-binary and set:
# DATABASE_URL=postgresql+psycopg2://fraud_user:your_url_safe_password@localhost:5432/fraud_db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_AUTH_TOKEN=ec201b31dba240fcb5917c3c17aeddf9d1003da5a9e408f24b780b3fbcfd5d36501421b8ef9cbe0f635c9ee4b9133c9b
API_RATE_LIMIT_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Model & Engine Paths
MODELS_DIR=models
BUSINESS_RULES_PATH=configs/business_rules.yaml
API_BASE_URL=http://localhost:8000

# Docker Compose PostgreSQL
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=8b6ab046094c20ab13b1a879874072364564c5f54a87824ecdbecba89c6923fd
SYNTHETIC_TRANSACTIONS=20000

# Risk Engine Thresholds
HIGH_RISK_THRESHOLD=0.75
